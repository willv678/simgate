+class TestMirror:
+    """With mirror, VaVAM drives the mirror image of the scene."""
+
+    def _fixed_plan(self, mock_vam):
+        plan = torch.zeros(1, 1, 6, 2)
+        plan[..., 0] = torch.arange(1, 7, dtype=torch.float32)
+        plan[..., 1] = 0.5  # half a metre left in VaVAM's frame
+        mock_vam.side_effect = lambda tokens, commands, dtype: plan.repeat(
+            tokens.shape[0], 1, 1, 1
+        )
+
+    def test_commands_swap_left_and_right(self, vam_model):
+        model, _, mock_vam = vam_model
+        model._mirror = True
+        for given, sent in (
+            (DriveCommand.RIGHT, 1),  # VAM LEFT
+            (DriveCommand.LEFT, 0),  # VAM RIGHT
+            (DriveCommand.STRAIGHT, 2),
+        ):
+            model.predict(_make_prediction_input(command=given))
+            assert mock_vam.call_args.args[1].item() == sent
+
+    def test_frames_are_flipped_left_to_right(self, vam_model):
+        model, _, _ = vam_model
+        model._mirror = True
+        seen = []
+        model._preproc_pipeline.side_effect = lambda img: (
+            seen.append(img),
+            torch.rand(3, 224, 224),
+        )[1]
+        with mock.patch.object(model, "_resize_and_center_crop", lambda img, h, w: img):
+            model.predict(_make_prediction_input(seed=0))
+        np.testing.assert_array_equal(seen[0], _make_image(0)[:, ::-1])
+
+    def test_the_plan_is_mirrored_back(self, vam_model):
+        model, _, mock_vam = vam_model
+        self._fixed_plan(mock_vam)
+        plain = model.predict(_make_prediction_input()).selected_positions
+        model._mirror = True
+        mirrored = model.predict(_make_prediction_input()).selected_positions
+        np.testing.assert_allclose(mirrored[:, 0], plain[:, 0])
+        np.testing.assert_allclose(mirrored[:, 1], -plain[:, 1])
